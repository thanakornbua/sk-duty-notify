{
  "name": "sk-duty-notify",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "perf": "node scripts/perf.mjs",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.mjs --sourcemap --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node --enable-source-maps dist/server.mjs",
    "smoke": "npm run build:server && node scripts/smoke-selfhost.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261023.1": true
  },
  "license": "MIT",
  "dependencies": {
    "nodemailer": "10.2.1"
  }
}
