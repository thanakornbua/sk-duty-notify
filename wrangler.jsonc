{
  "name": "sk-duty-notify",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sk-duty-notify",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Per-IP limit on /api/*, checked before any call to LINE. Generous because a school Wi-Fi NAT may put
  // many members behind one IP. Period must be 10 or 60 s.
  "ratelimits": [{ "name": "IP_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }]
}
