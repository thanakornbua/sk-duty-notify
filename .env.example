# sk-duty-notify self-hosted configuration. Copy to .env (gitignored) and fill in.

# Public origin, exactly as members and Google see it (no trailing slash).
PUBLIC_URL=https://duty.example.ac.th

# LINE Messaging API channel (the Official Account)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login channel holding the LIFF app (same provider). LIFF endpoint URL: <PUBLIC_URL>/liff
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# Google Cloud OAuth client ("Web application"). Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these Google Workspace domains can sign in (members and admins). Comma-separated.
GOOGLE_ALLOWED_DOMAINS=example.ac.th,student.example.ac.th
# Google emails that always have a management account (use for the first admin). Comma-separated.
INITIAL_ADMIN_EMAILS=

# Email (SMTP): check-in receipts always, plus email copies of notices if turned on in Settings.
# Google Workspace: smtp.gmail.com, port 465, a sending account + an App Password (2-Step Verification on),
#                   or smtp-relay.gmail.com, port 587 (Workspace SMTP relay, set up in the Admin console).
# Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to members, e.g.  SK Duty <duty@example.ac.th>  (Gmail rewrites it to SMTP_USER unless it is an alias)
SMTP_FROM=

# Cloudflare Tunnel token (compose.yaml only; Kubernetes uses k8s/tunnel.env)
TUNNEL_TOKEN=

# Optional
# SCHEDULER_BATCH_SIZE=200     # messages per minute-run
# BACKUP_KEEP=14               # daily database backups kept in /data/backups (0 = off)
# ALLOW_PASSWORD_LOGIN=0       # 1 = also allow break-glass username/password admins (scripts/create-admin.mjs)
# RATE_LIMIT=120               # requests per IP per RATE_PERIOD_SECONDS on /api/* and admin login
# SMTP_RATE_PER_SECOND=5      # messages per second (stay under your provider's limits)
# SMTP_SECURE=1                # 1 = TLS from the start (port 465); default: 1 on port 465, STARTTLS otherwise
# PORT=8787
