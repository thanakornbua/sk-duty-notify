# Secrets (Secret). Copy to app.env (gitignored) and fill in.
# LINE Messaging API channel (the Official Account)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login channel that holds the LIFF app (same provider as the Messaging API channel)
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=
# Google Cloud OAuth client, type "Web application".
# Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP password (App Password for smtp.gmail.com). Other SMTP settings: config.env
SMTP_PASS=
