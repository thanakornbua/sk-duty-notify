# Non-secret settings (ConfigMap). Edit, then: kubectl apply -k k8s/
PUBLIC_URL=https://duty.example.ac.th
GOOGLE_ALLOWED_DOMAINS=example.ac.th,student.example.ac.th
# Google emails that always have a management account (first sign-in). Comma-separated.
INITIAL_ADMIN_EMAILS=
SCHEDULER_BATCH_SIZE=200
BACKUP_KEEP=14
ALLOW_PASSWORD_LOGIN=0

# Email (SMTP): check-in receipts always, plus email copies of notices if turned on in Settings.
# Google Workspace: smtp.gmail.com, port 465, a sending account + an App Password (2-Step Verification on),
#                   or smtp-relay.gmail.com, port 587 (Workspace SMTP relay, set up in the Admin console).
# Leave SMTP_HOST empty to disable email. The password goes in app.env (SMTP_PASS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_FROM=
